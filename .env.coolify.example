PORT=8080

# Coolify/container defaults. Keep browser automation headless in Linux containers.
# The Docker image also includes Node.js because Douyin signing uses pyexecjs.
SAVE_DATA_PATH=/app/data
USER_DATA_DIR=/app/browser-data/%s_user_data_dir
HEADLESS=true
CDP_HEADLESS=true
ENABLE_CDP_MODE=false
CDP_CONNECT_EXISTING=false
FORCE_HEADLESS=true

# Default crawler behavior. WebUI can still override most request-time options.
SAVE_DATA_OPTION=jsonl
MAX_CONCURRENCY_NUM=1
ENABLE_GET_COMMENTS=true
ENABLE_GET_SUB_COMMENTS=false

# Optional databases. If you add services in Coolify, use service names as hosts.
MYSQL_DB_HOST=mysql
MYSQL_DB_PORT=3306
MYSQL_DB_USER=root
MYSQL_DB_PWD=change-me
MYSQL_DB_NAME=media_crawler

REDIS_DB_HOST=redis
REDIS_DB_PORT=6379
REDIS_DB_PWD=
REDIS_DB_NUM=0

MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PWD=
MONGODB_DB_NAME=media_crawler

POSTGRES_DB_HOST=postgres
POSTGRES_DB_PORT=5432
POSTGRES_DB_USER=postgres
POSTGRES_DB_PWD=change-me
POSTGRES_DB_NAME=media_crawler
